# Copia este archivo a ".env" y cambia los valores. NUNCA subas ".env" a Git.
# Para correr el backend en modo dev, copia también el .env a backend/.env

# --- Neo4j (mínimo 8 caracteres, sin comillas) ---
NEO4J_PASSWORD=cambia_esta_clave
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# --- Almacenamiento S3 (RustFS) (mínimo 8 caracteres cada uno) ---
S3_ACCESS_KEY=cambia_access_key
S3_SECRET_KEY=cambia_secret_key_larga
S3_BUCKET=posts-media
S3_ENDPOINT=http://localhost:9000

# --- Web Push (Persona D) ---
# Genera las llaves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=genera_con_npx_web_push_generate-vapid-keys
VAPID_PRIVATE_KEY=genera_con_npx_web_push_generate-vapid-keys
VAPID_SUBJECT=mailto:admin@redsocial.local
