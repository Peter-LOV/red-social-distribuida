# Copia este archivo a ".env" y cambia los valores. NUNCA subas ".env" a Git.
# Para correr el backend en modo dev, copia también el .env a backend/.env

# --- Neo4j (mínimo 8 caracteres, sin comillas) ---
NEO4J_PASSWORD=cambia_esta_clave
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# --- Almacenamiento S3 (RustFS) (mínimo 8 caracteres cada uno) ---
S3_ACCESS_KEY=cambia_access_key
S3_SECRET_KEY=cambia_secret_key_larga
S3_BUCKET=posts-media
S3_ENDPOINT=http://localhost:9000

# --- Web Push (Persona D) ---
# Genera las llaves con: npx web-push generate-vapid-keys
# IMPORTANTE: Cada integrante debe generar sus propias llaves VAPID
# Las llaves deben ser las mismas en desarrollo y producción
# PON LAS LLAVES EN .env (NO en este archivo que se sube a Git)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@redsocial.local

# --- JWT (solo para modo dev local) ---
# En Docker las llaves se generan automáticamente con el servicio jwt-keys
# Para modo dev local, ejecuta: .\scripts\generate-jwt-keys.ps1
# NO las subas a Git
JWT_PUBLIC_KEY_PATH=/publicKey.pem
JWT_PRIVATE_KEY_PATH=/privateKey.pem
